<div class="info-section">
    <div class="user-infos">
        <div class="profile">
            <img class="profile-picture" alt="" src="">
            <div class="user">
                <p class="username">{{user.login}}</p>
                {{#if is_admin}}
                    <a class="role" href="/administration">{{user.user_role}}</a>
                {{else}}
                    <p class="role">{{user.user_role}}</p>
                {{/if}}
            </div>
            {{#if is_self}}
                <button class="edit" onclick="{{ctx "edit()"}}"><img alt="edit"
                                                                     src="/public/images/icons/icons8-edit-96.png">
                </button>
            {{/if}}
        </div>
        {{#if user.email}}
            <a href="mailto:{{user.email}}">{{user.email}}</a>
        {{/if}}
    </div>
    <div class="repository-list">
        <h1>Dépôts :</h1>
        <div class="list" {{object "repository_list"}}>
        </div>
    </div>
</div>
<div {{object "tokens"}} class="tokens"></div>