<form onsubmit="{{ctx 'submit(event)'}}">
    <h1>Modifier l'élément {{name}}</h1>
    <div class="field">
        <label for='display_name'>Nom</label>
        <input type="text" name="display_name" placeholder="Nom" {{object "display_name"}} required
               value="{{name}}">

    </div>
    <div class="field">
        <label for='description'>Description</label>
        <textarea name="description" placeholder="Description" {{object "description"}} rows="8">{{description}}</textarea>
    </div>
    {{#if is_directory}}
        <div class="field">
            <label for='allow_visitor_upload'>Ouvrir la mise en ligne de fichiers à tous</label>
            <check-slider {{object "allow_visitor_upload"}} {{#if open_upload}}checked{{/if}}></check-slider>
        </div>
    {{/if}}
    <input type="submit" value="Confirmer">
</form>