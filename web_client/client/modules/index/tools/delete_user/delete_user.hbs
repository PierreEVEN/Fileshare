<form onsubmit="{{ctx 'delete_user(event)'}}">
    <h1>Supprimer le compte {{login}} (attention, celà entraine la suppression de toutes les données stockées sans
        exception)</h1>
    <label for='username'> </label>
    <input {{object "login"}} type="text" name="username" placeholder="Nom d'utilisateur / email" required>

    <label for='password'> </label>
    <input {{object "password"}} type="password" name="password" placeholder="Mot de passe" required>


    <input type="submit" value="Supprimer">
</form>