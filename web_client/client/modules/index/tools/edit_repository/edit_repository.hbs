<form onsubmit="{{ctx 'submit(event)'}}">
    <h1>Modifier le dépôt {{display_name}}</h1>
    <div class="field">
        <label for='display_name'>Nom</label>
        <input type="text" name="display_name" placeholder="Nom" required
               value="{{display_name}}" {{object "display_name"}}>

    </div>
    <div class="field">
        <label for='description'>Description</label>
        <textarea name="description" placeholder="Description" rows="8" {{object "description"}}>{{description}}</textarea>
    </div>
    <div class="field">
        <label for='max_file_size'>Taille maximale des fichiers</label>
        <input type="number" name="max_file_size" value="{{max_file_size}}" {{object "max_file_size"}}>

    </div>
    <div class="field">
        <label for='visitor_file_lifetime'>Durée de vie des données invités</label>
        <input type="number" name="visitor_file_lifetime" value="{{visitor_file_lifetime}}" {{object "visitor_file_lifetime"}}>

    </div>
    <div class="danger-zone">
        <h2>⚠️Danger zone⚠️</h2>
        <div class="field">
            <label for='url_name'>Nom dans l'url</label>
            <input type="text" name="name" required value="{{url_name}}" {{object "url_name"}}>
        </div>
        <div class="field">
            <label for='status'>Visibilité</label>
            <select name="status" onChange="" {{object "status"}}>
                <option value="hidden" {{#if prop_hidden}}selected{{/if}}>Invisible</option>
                <option value="public" {{#if prop_public}}selected{{/if}}>Publique</option>
                <option value="private" {{#if prop_private}}selected{{/if}}>Privé</option>
            </select>
        </div>
        <div class="field">
            <label for='allow_visitor_upload'>Ouvrir la mise en ligne de fichiers à tous </label>
            <check-slider {{#if allow_visitor_upload}}checked{{/if}} {{object "allow_visitor_upload"}}></check-slider>
        </div>
        <div class="field">
            <input type="button" class="cancel-button" onclick="{{ctx 'delete()'}}"
                   value="Supprimer le dépôt et son contenu">
        </div>
    </div>
    <input type="submit" value="Confirmer">
</form>