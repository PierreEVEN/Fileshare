<div class="stats-viewport">
    <h1>Server statistics</h1>
    <div class="data">
        <h2>Data</h2>
        <div class="categories" {{object "categories"}}>
        </div>
    </div>
    <div class="hardware">
        <h2>Hardware</h2>
        <div class="progress">
            <h2>Workload</h2>
            <div class="bar-container">
                <p {{object "workload_txt"}}></p>
                <div class="bar" {{object "workload_bar"}}></div>
            </div>
        </div>
        <div class="progress">
            <h2>Ram</h2>
            <div class="bar-container">
                <p {{object "ram_txt"}}></p>
                <div class="bar" {{object "ram_bar"}}></div>
            </div>
        </div>
        <div class="progress">
            <h2>Swap</h2>
            <div class="bar-container">
                <p {{object "swap_txt"}}></p>
                <div class="bar" {{object "swap_bar"}}></div>
            </div>
        </div>
        <h2>Cpus</h2>
        <div class="cat" {{object "cpus"}}></div>
        <h2>Disks</h2>
        <div class="cat" {{object "disks"}}></div>
        <h2>Network</h2>
        <div class="cat" {{object "networks"}}></div>
    </div>
    <div class="values">

    </div>
</div>