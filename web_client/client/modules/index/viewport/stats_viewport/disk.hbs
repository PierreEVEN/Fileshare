<div class="disk">
    <p>{{display_name}}</p>
    <div class="progress">
        <h2>Space</h2>
        <div class="bar-container">
            <p {{object "space_txt"}}></p>
            <div class="bar" {{object "space_bar"}}></div>
        </div>
    </div>
    <div class="progress">
        <h2>Read</h2>
        <div class="bar-container">
            <p {{object "read_txt"}}></p>
            <div class="bar" {{object "read_bar"}}></div>
        </div>
    </div>
    <div class="progress">
        <h2>Write</h2>
        <div class="bar-container">
            <p {{object "write_txt"}}></p>
            <div class="bar" {{object "write_bar"}}></div>
        </div>
    </div>
</div>