<div class="disk">
    <p>{{display_name}}</p>
    <div class="progress">
        <h2>Download</h2>
        <div class="bar-container">
            <p {{object "down_txt"}}></p>
            <div class="bar" {{object "down_bar"}}></div>
        </div>
    </div>
    <div class="progress">
        <h2>Upload</h2>
        <div class="bar-container">
            <p {{object "up_txt"}}></p>
            <div class="bar" {{object "up_bar"}}></div>
        </div>
    </div>
</div>