<video preload="auto" autoplay="" {{object "video"}}></video>
<div class="controller-container">
    <div {{object "videoController"}} class="video-controller unselectable">
        <div {{object "playPauseBtn"}} class="btn-play-pause" title="Play/Pause">
            <span {{object "iconPlayPause"}} class="icon-play"></span>
        </div>
        <span {{object "videoTime"}} class="time-display">00:00:00</span>
        <div {{object "fullscreenBtn"}} class="btn-fullscreen control-icon-layout" title="Fullscreen">
            <span class="icon-fullscreen-enter"></span>
        </div>
        <div {{object "bitrateListBtn"}} class="control-icon-layout" title="Bitrate List">
            <span class="icon-bitrate"></span>
        </div>
        <input type="range" {{object "volumebar"}} class="volumebar" value="1" min="0" max="1" step=".01">
        <div {{object "muteBtn"}} class="btn-mute control-icon-layout" title="Mute">
            <span {{object "iconMute"}} class="icon-mute-off"></span>
        </div>
        <div {{object "trackSwitchBtn"}} class="control-icon-layout" title="A/V Tracks">
            <span class="icon-tracks"></span>
        </div>
        <div {{object "captionBtn"}} class="btn-caption control-icon-layout" title="Closed Caption">
            <span class="icon-caption"></span>
        </div>
        <span {{object "videoDuration"}} class="duration-display">00:00:00</span>
        <div class="seekContainer">
            <div {{object "seekbar"}} class="seekbar seekbar-complete">
                <div {{object "seekbar_buffer"}} class="seekbar seekbar-buffer"></div>
                <div {{object "seekbar_play"}} class="seekbar seekbar-play"></div>
            </div>
        </div>
    </div>
</div>