<viewport-toolbar {{object "toolbar"}}></viewport-toolbar>
<div class="mobile-selection" {{object "mobile_selection"}}>
    <button onclick="{{ctx "unselect_all()"}}" tabindex="-1"><img src="/public/images/icons/icons8-back-50.png" alt="back">
        <p {{object "num_elements"}}></p></button>
    <button class="more-btn" onclick="{{ctx "ctx_selection()"}}" tabindex="-1"><img src="/public/images/icons/icons8-ellipsis-90.png" alt="back"></button>
</div>
<div class="repository-content">
    <content-page {{object "content"}}></content-page>
    <div class="current-description" {{object "current_description"}}></div>
</div>
<div class="upload-container" {{object "upload_container"}}></div>
<button class="upload-button" {{object "upload_button"}} onclick="{{ctx "open_upload()"}}" tabindex="-1"><img src="/public/images/icons/icons8-add-file-48.png" alt="upload-to-cloud"></button>
<upload-drop-box {{object "drop_box"}}></upload-drop-box>
