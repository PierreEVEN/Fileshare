<div class="info-section">
    <div class="user-infos">
        <div class="profile">
            <img class="profile-picture" alt="" src="">
            <div class="user">
                <p class="username">{{user.login}}</p>
                {{#if is_admin}}
                    <a class="role" onclick="{{ctx "admin()"}}">{{user.user_role}}</a>
                {{else}}
                    <p class="role">{{user.user_role}}</p>
                {{/if}}
            </div>
            {{#if is_self}}
                <button class="edit" onclick="{{ctx "edit()"}}"><img alt="edit"
                                                                     src="/public/images/icons/icons8-edit-96.png">
                </button>
            {{/if}}
        </div>
        {{#if user.email}}
            <a href="mailto:{{user.email}}">{{user.email}}</a>
        {{/if}}
    </div>
</div>
<div class="repository-list">
    <div class="title">
        <img alt="repositories" src="/public/images/icons/icons8-storage-96.png">
        <h2>Mes dépôts :</h2>
    </div>
    <div class="list" {{object "repository_list"}}>
    </div>
</div>
<div class="section-tokens">
    <div class="title">
        <img alt="devices" src="/public/images/icons/icons8-url-96.png">
        <h2>Appareils connectés</h2>
    </div>
    <div {{object "tokens"}} class="tokens">
        <div class="token head">
            <div class="field device">
                <p>Appareil</p>
            </div>
            <div class="field">
                <p class="expiration">Date d'expiration</p>
            </div>
            <div class="field">
                <p>Supprimer</p>
            </div>
        </div>
    </div>
</div>