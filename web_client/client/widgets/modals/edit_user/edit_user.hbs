<form onsubmit="{{ctx 'submit(event)'}}">
    <h1>Paramètres du compte {{display_name}}</h1>
    <div class="field">
        <label for='display_name'>Nom</label>
        <input type="text" name="display_name" placeholder="Nom" {{object "display_name"}} required
               value="{{login}}">
    </div>
    <div class="field">
        <label for='mask_email'>Masker mon email</label>
        <check-slider {{object "mask_email"}} {{#if mask_email}}checked{{/if}}></check-slider>

    </div>
    <div class="danger-zone">
        <h2>⚠️Danger zone⚠️</h2>
        <div class="field">
            <label for='url_name'>Nom dans l'url</label>
            <input type="text" name="name" {{object "url_name"}} required value="{{name}}">
        </div>
        <input type="button" class="cancel-button" onclick="{{ctx 'delete()'}}"
               value="Supprimer le compte et toutes les données associées">
    </div>
    <input type="submit" value="Confirmer">
</form>