<form onsubmit="{{ctx 'create_repository(event)'}}">
    <h1>Nouveau dépôt</h1>
    <div class="field">
        <label for="repository-name"></label>
        <input type="text" name="name" placeholder="Nom" {{object "repository_name"}} required>
    </div>
    <div class="field">
        <label for="repository-type">Visibilité</label>
        <select name="type" {{object "repository_type"}}>
            <option value="private">Privé</option>
            <option value="hidden">Invisible</option>
            <option value="public">Publique</option>
        </select>
    </div>
    <input type="submit" value="Nouveau dépot">
</form>